{
  "episode": "hiramoto_dautbek_short",
  "total": 74.092,
  "beats": [
    {
      "id": "t0",
      "idx": 0,
      "start": 0.18,
      "end": 4.295,
      "text": "どう見てもダウトベック。ひらもとれんの判定勝ちに賛否が割れています。"
    },
    {
      "id": "h1",
      "idx": 1,
      "start": 4.455,
      "end": 9.139,
      "text": "スーパーライジンファイブ第6試合、ひらもとれんとカルシャガダウトベックの一戦です。"
    },
    {
      "id": "h2",
      "idx": 2,
      "start": 9.299,
      "end": 13.304,
      "text": "結果ははんていにたいいち。ジャッジひとりはダウトベックを支持しました。"
    },
    {
      "id": "c1",
      "idx": 3,
      "start": 13.464,
      "end": 19.22,
      "text": "いちラウンド、ダウトベックの左が何度もクリーンヒット。それでもひらもとは倒れませんでした。"
    },
    {
      "id": "c2",
      "idx": 4,
      "start": 19.38,
      "end": 22.573,
      "text": "にラウンドは、ひらもとがインローを効かせて盛り返します。"
    },
    {
      "id": "c3",
      "idx": 5,
      "start": 22.733,
      "end": 27.825,
      "text": "さんラウンドはダウトベックが何度もテイクダウン。ただ倒したあとの攻撃は多くありませんでした。"
    },
    {
      "id": "c4",
      "idx": 6,
      "start": 27.985,
      "end": 32.84,
      "text": "判定の瞬間、いちばん驚いていたのはひらもと本人。そんな声も上がっています。"
    },
    {
      "id": "c5",
      "idx": 7,
      "start": 33.0,
      "end": 36.92,
      "text": "エスエヌエスでは、どう見てもダウトベックという声が多数です。"
    },
    {
      "id": "x1",
      "idx": 8,
      "start": 37.08,
      "end": 43.575,
      "text": "かわはらゆうじさんは、人気があるから、スターだから。それが判定に入るならスポーツじゃない、としました。"
    },
    {
      "id": "x2",
      "idx": 9,
      "start": 43.735,
      "end": 49.086,
      "text": "格闘技ライターのジャンさいとうさんは、分かれ目はさんラウンドのポジションキープの見方だとしています。"
    },
    {
      "id": "x3",
      "idx": 10,
      "start": 49.246,
      "end": 55.642,
      "text": "ダウトベックは組んだあとに何もしなかった。ライジンの判定なら有効打でひらもとだ、という声もあります。"
    },
    {
      "id": "c7",
      "idx": 11,
      "start": 55.802,
      "end": 60.016,
      "text": "ダウンがなかったぶん、いちラウンドをじゅうたいはちにするかで採点が割れました。"
    },
    {
      "id": "e1",
      "idx": 12,
      "start": 60.176,
      "end": 67.596,
      "text": "報じられたジャッジスコアは、にじゅうきゅうたいにじゅうはちでひらもとがふたり。にじゅうきゅうたいにじゅうななでダウトベックがひとりでした。"
    },
    {
      "id": "e1b",
      "idx": 13,
      "start": 67.756,
      "end": 71.349,
      "text": "ひとりだけが、いちラウンドをじゅうたいはちと見ていた計算になります。"
    },
    {
      "id": "e2",
      "idx": 14,
      "start": 71.509,
      "end": 73.642,
      "text": "あなたはどちらの勝ちだと思いますか。"
    }
  ]
}