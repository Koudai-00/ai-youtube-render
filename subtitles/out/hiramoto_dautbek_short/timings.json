  "beats": [
    {
      "id": "t0",
      "idx": 0,
      "start": 0.18,
      "end": 4.295,
      "text": "どう見てもダウトベック。ひらもとれんの判定勝ちに賛否が割れています。"
    },
    {
      "id": "h1",
      "idx": 1,
      "start": 4.455,
      "end": 9.139,
      "text": "スーパーライジンファイブ第6試合、ひらもとれんとカルシャガダウトベックの一戦です。"
    },
    {
      "id": "h2",
      "idx": 2,
      "start": 9.299,
      "end": 13.304,
      "text": "結果ははんていにたいいち。ジャッジひとりはダウトベックを支持しました。"
    },
    {
      "id": "c1",
      "idx": 3,
      "start": 13.464,
      "end": 18.562,
      "text": "いちラウンド、ダウトベックの左がクリーンヒット。ひらもとはキャンバスに落ちました。"
    },
    {
      "id": "c2",
      "idx": 4,
      "start": 18.722,
      "end": 21.914,
      "text": "にラウンドは、ひらもとがインローを効かせて盛り返します。"
    },
    {
      "id": "c3",
      "idx": 5,
      "start": 22.074,
      "end": 27.166,
      "text": "さんラウンドはダウトベックが何度もテイクダウン。ただ倒したあとの攻撃は多くありませんでした。"
    },
    {
      "id": "c4",
      "idx": 6,
      "start": 27.326,
      "end": 32.181,
      "text": "判定の瞬間、いちばん驚いていたのはひらもと本人。そんな声も上がっています。"
    },
    {
      "id": "c5",
      "idx": 7,
      "start": 32.341,
      "end": 36.261,
      "text": "エスエヌエスでは、どう見てもダウトベックという声が多数です。"
    },
    {
      "id": "x1",
      "idx": 8,
      "start": 36.421,
      "end": 42.916,
      "text": "かわはらゆうじさんは、人気があるから、スターだから。それが判定に入るならスポーツじゃない、としました。"
    },
    {
      "id": "x2",
      "idx": 9,
      "start": 43.076,
      "end": 50.946,
      "text": "格闘技ライターのジャンさいとうさんは、いちラウンドはダウトベック、にラウンドはひらもとと採点。分かれ目はさんラウンドだとしています。"
    },
    {
      "id": "x3",
      "idx": 10,
      "start": 51.106,
      "end": 57.502,
      "text": "ダウトベックは組んだあとに何もしなかった。ライジンの判定なら有効打でひらもとだ、という声もあります。"
    },
    {
      "id": "c7",
      "idx": 11,
      "start": 57.662,
      "end": 62.523,
      "text": "いちラウンドをじゅうたいはちにしなければ、にたいいちでひらもとという計算も成り立ちます。"
    },
    {
      "id": "e1",
      "idx": 12,
      "start": 62.683,
      "end": 66.155,
      "text": "公式のジャッジスコアの内訳は、まだ公表されていません。"
    },
    {
      "id": "e2",
      "idx": 13,
      "start": 66.315,
      "end": 68.488,
      "text": "あなたはどちらの勝ちだと思いますか。"
    }
  ]
}