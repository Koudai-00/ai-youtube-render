  ],
  "beats": [
    {
      "id": "0_intro00",
      "sec": "s0_intro",
      "idx": 0,
      "start": 0.3,
      "end": 3.69,
      "text": "ダウンを奪ったのは、那須川天心選手でした。"
    },
    {
      "id": "0_intro01",
      "sec": "s0_intro",
      "idx": 1,
      "start": 3.97,
      "end": 11.261,
      "text": "それでも公式の採点はこうでした。ひゃくじゅうよんたいひゃくじゅうさん。ひゃくじゅうろくたいひゃくじゅういちがふたり。"
    },
    {
      "id": "0_intro02",
      "sec": "s0_intro",
      "idx": 2,
      "start": 11.541,
      "end": 15.86,
      "text": "さんにんのジャッジが全員、王者の井上拓真選手につけています。"
    },
    {
      "id": "0_intro03",
      "sec": "s0_intro",
      "idx": 3,
      "start": 16.14,
      "end": 22.456,
      "text": "ところが、はちラウンドが終わった時点ではひとりのジャッジが那須川天心選手を上に置いていました。"
    },
    {
      "id": "0_intro04",
      "sec": "s0_intro",
      "idx": 4,
      "start": 22.736,
      "end": 30.166,
      "text": "公開された採点と公式の採点表を突き合わせると、さんにんのカードはいちラウンドずつすべて復元できます。"
    },
    {
      "id": "0_intro05",
      "sec": "s0_intro",
      "idx": 5,
      "start": 30.446,
      "end": 33.836,
      "text": "そこに現れたのは、ダウンの場面ではありませんでした。"
    },
    {
      "id": "0_intro06",
      "sec": "s0_intro",
      "idx": 6,
      "start": 34.116,
      "end": 40.2,
      "text": "採点はなぜ真っ二つに割れたのでしょうか。じゅうにラウンドを、いちラウンドずつ検証します。"
    },
    {
      "id": "1_what00",
      "sec": "s1_what",
      "idx": 0,
      "start": 42.93,
      "end": 51.057,
      "text": "にせん にじゅうろくねんくがつにじゅうななにち。トヨタアリーナ東京で、WBC世界バンタム級タイトルマッチが行われました。"
    },
    {
      "id": "1_what01",
      "sec": "s1_what",
      "idx": 1,
      "start": 51.337,
      "end": 57.188,
      "text": "王者は井上拓真選手。挑戦者は同級いちいの那須川天心選手です。"
    },
    {
      "id": "1_what02",
      "sec": "s1_what",
      "idx": 2,
      "start": 57.468,
      "end": 59.883,
      "text": "ふたりが戦うのはこれがにどめでした。"
    },
    {
      "id": "1_what03",
      "sec": "s1_what",
      "idx": 3,
      "start": 60.163,
      "end": 68.894,
      "text": "だいいっせんは、にせん にじゅうごねんじゅういちがつにじゅうよっか。空位になっていたWBC世界バンタム級の王座決定戦でした。"
    },
    {
      "id": "1_what04",
      "sec": "s1_what",
      "idx": 4,
      "start": 69.174,
      "end": 77.719,
      "text": "結果はひゃくじゅうろくたいひゃくじゅうにがふたり、ひゃくじゅうななたいひゃくじゅういちがひとり。井上拓真選手のさんたいゼロの判定勝ちです。"
    },
    {
      "id": "1_what05",
      "sec": "s1_what",
      "idx": 5,
      "start": 77.999,
      "end": 84.686,
      "text": "那須川天心選手にとっては、キックボクシング時代を含めたプロ公式戦で初めての黒星でした。"
    },
    {
      "id": "1_what06",
      "sec": "s1_what",
      "idx": 6,
      "start": 84.966,
      "end": 92.257,
      "text": "井上拓真選手はそのあと、二千二十六年五月二日の東京ドームで井岡一翔選手を迎えます。"
    },
    {
      "id": "1_what07",
      "sec": "s1_what",
      "idx": 7,
      "start": 92.537,
      "end": 98.853,
      "text": "さんたいゼロの大差判定で初防衛に成功し、井岡一翔選手のごかいきゅうせいはを阻みました。"
    },
    {
      "id": "1_what08",
      "sec": "s1_what",
      "idx": 8,
      "start": 99.133,
      "end": 104.892,
      "text": "そしてだいいっせんからさんびゃくななにち。那須川天心選手が同じ相手に挑みました。"
    },
    {
      "id": "1_what09",
      "sec": "s1_what",
      "idx": 9,
      "start": 105.172,
      "end": 108.748,
      "text": "試合は序盤から井上拓真選手がペースを握ります。"
    },
    {
      "id": "1_what10",
      "sec": "s1_what",
      "idx": 10,
      "start": 109.028,
      "end": 117.015,
      "text": "流れが動いたのはななラウンドでした。開始からやくにじゅうびょう、那須川天心選手の左ストレートが王者をとらえます。"
    },
    {
      "id": "1_what11",
      "sec": "s1_what",
      "idx": 11,
      "start": 117.295,
      "end": 124.865,
      "text": "井上拓真選手はダウン。さんにんのジャッジ全員が、このラウンドをじゅうたいはちで那須川天心選手につけました。"
    },
    {
      "id": "1_what12",
      "sec": "s1_what",
      "idx": 12,
      "start": 125.145,
      "end": 129.928,
      "text": "しかし残るごラウンドで、井上拓真選手が主導権を取り戻します。"
    },
    {
      "id": "1_what13",
      "sec": "s1_what",
      "idx": 13,
      "start": 130.208,
      "end": 136.756,
      "text": "判定はさんたいゼロ。那須川天心選手はリングで号泣し、ファンに土下座をしました。"
    },
    {
      "id": "1_what14",
      "sec": "s1_what",
      "idx": 14,
      "start": 137.036,
      "end": 142.423,
      "text": "本当にボクシングで負けた感じ。ポイントゲーム。負けた気していないんですよ。"
    },
    {
      "id": "1_what15",
      "sec": "s1_what",
      "idx": 15,
      "start": 142.703,
      "end": 145.908,
      "text": "試合後、那須川天心選手はそう話しています。"
    },
    {
      "id": "2_open00",
      "sec": "s2_open",
      "idx": 0,
      "start": 148.638,
      "end": 154.675,
      "text": "この試合には、日本の世界戦で使われる特殊なルールがありました。オープンスコアリングです。"
    },
    {
      "id": "2_open01",
      "sec": "s2_open",
      "idx": 1,
      "start": 154.955,
      "end": 162.478,
      "text": "WBCが採用している制度で、よんラウンドとはちラウンドが終わった時点でジャッジさんにんの採点が公開されます。"
    },
    {
      "id": "2_open02",
      "sec": "s2_open",
      "idx": 2,
      "start": 162.758,
      "end": 169.446,
      "text": "不正を防ぎ、採点を透明にするための仕組みです。国際的に一般的なものではありません。"
    },
    {
      "id": "2_open03",
      "sec": "s2_open",
      "idx": 3,
      "start": 169.726,
      "end": 175.67,
      "text": "そのよんラウンド終了時。公開された採点は、さんにんがそれぞれ違う数字でした。"
    },
    {
      "id": "2_open04",
      "sec": "s2_open",
      "idx": 4,
      "start": 175.95,
      "end": 180.315,
      "text": "ひとりはよんじゅうたいさんじゅうろく。井上拓真選手のフルマークです。"
    },
    {
      "id": "2_open05",
      "sec": "s2_open",
      "idx": 5,
      "start": 180.595,
      "end": 187.097,
      "text": "ひとりはさんじゅうきゅうたいさんじゅうなな。そしてもうひとりは、さんじゅうはちたいさんじゅうはちのドローでした。"
    },
    {
      "id": "2_open06",
      "sec": "s2_open",
      "idx": 6,
      "start": 187.377,
      "end": 193.507,
      "text": "同じよんラウンドを見て、全部井上拓真選手という採点と互角という採点が同居しています。"
    },
    {
      "id": "2_open07",
      "sec": "s2_open",
      "idx": 7,
      "start": 193.787,
      "end": 195.691,
      "text": "ここから試合が変わりました。"
    },
    {
      "id": "2_open08",
      "sec": "s2_open",
      "idx": 8,
      "start": 195.971,
      "end": 203.355,
      "text": "那須川天心選手が所属する帝拳プロモーションの浜田剛史代表は、一夜明け会見でこう語っています。"
    },
    {
      "id": "2_open09",
      "sec": "s2_open",
      "idx": 9,
      "start": 203.635,
      "end": 210.322,
      "text": "よんラウンドの採点を聞いて、取られているのかと。さんにんのジャッジの取り方がわかったのは良かった。"
    },
    {
      "id": "2_open10",
      "sec": "s2_open",
      "idx": 10,
      "start": 210.602,
      "end": 217.94,
      "text": "公開採点でのドローを聞いて、那須川天心選手のこのやり方ではポイントがつかないことに焦りがあったのは事実です。"
    },
    {
      "id": "2_open11",
      "sec": "s2_open",
      "idx": 11,
      "start": 218.22,
      "end": 224.21,
      "text": "挑戦者の陣営が、自分たちの戦い方では点が入らないと気づいた瞬間でした。"
    },
    {
      "id": "2_open12",
      "sec": "s2_open",
      "idx": 12,
      "start": 224.49,
      "end": 232.85,
      "text": "元WBC世界ライトフライ級王者の木村悠さんは、この制度が選手に心理的な圧力をかけると指摘します。"
    },
    {
      "id": "2_open13",
      "sec": "s2_open",
      "idx": 13,
      "start": 233.13,
      "end": 240.235,
      "text": "ジャッジにどう見えているかを考えさせてしまう。それが試合の流れそのものを変えてしまうという見方です。"
    },
    {
      "id": "3_pros00",
      "sec": "s3_pros",
      "idx": 0,
      "start": 242.965,
      "end": 247.052,
      "text": "この試合の採点は、専門家の間でも真っ二つに割れました。"
    },
    {
      "id": "3_pros01",
      "sec": "s3_pros",
      "idx": 1,
      "start": 247.332,
      "end": 257.177,
      "text": "じゅうさんどの防衛を果たした元WBA世界ライトフライ級王者、具志堅用高さんの採点は那須川天心選手のにポイント勝ちでした。"
    },
    {
      "id": "3_pros02",
      "sec": "s3_pros",
      "idx": 2,
      "start": 257.457,
      "end": 263.726,
      "text": "試合は勝ってるけど採点で負けた。那須川天心選手がかわいそうだ。そう話しています。"
    },
    {
      "id": "3_pros03",
      "sec": "s3_pros",
      "idx": 3,
      "start": 264.006,
      "end": 271.53,
      "text": "元WBC世界フライ級王者の内藤大助さんも、よんラウンド時点はさんじゅうはちたいさんじゅうはちでした。"
    },
    {
      "id": "3_pros04",
      "sec": "s3_pros",
      "idx": 4,
      "start": 271.81,
      "end": 280.354,
      "text": "フルマークで他のラウンドを取らない限り那須川天心選手に勝ち目はない。公開採点を聞いた時点でそう感じたと語ります。"
    },
    {
      "id": "3_pros05",
      "sec": "s3_pros",
      "idx": 5,
      "start": 280.634,
      "end": 287.368,
      "text": "元日本王者の赤穂亮さんはさんじゅうきゅうたいさんじゅうなな。よんポイントの差はないという見立てです。"
    },
    {
      "id": "3_pros06",
      "sec": "s3_pros",
      "idx": 6,
      "start": 287.648,
      "end": 294.103,
      "text": "トレーナーの椎野大輝さんも、さんじゅうはちたいさんじゅうはちかさんじゅうきゅうたいさんじゅうななで見ていました。"
    },
    {
      "id": "3_pros07",
      "sec": "s3_pros",
      "idx": 7,
      "start": 294.383,
      "end": 296.566,
      "text": "フルマークは意外だったと話しています。"
    },
    {
      "id": "3_pros08",
      "sec": "s3_pros",
      "idx": 8,
      "start": 296.846,
      "end": 301.072,
      "text": "一方で、井上拓真選手の勝ちをはっきり支持した人もいます。"
    },
    {
      "id": "3_pros09",
      "sec": "s3_pros",
      "idx": 9,
      "start": 301.352,
      "end": 308.318,
      "text": "元WBA世界スーパーフェザー級王者の内山高志さんの採点は、ひゃくじゅうごたいひゃくじゅうに。"
    },
    {
      "id": "3_pros10",
      "sec": "s3_pros",
      "idx": 10,
      "start": 308.598,
      "end": 315.703,
      "text": "元RIZINの川尻達也選手も同じひゃくじゅうごたいひゃくじゅうにで、ふたりの差はむしろ開いたと見ています。"
    },
    {
      "id": "3_pros11",
      "sec": "s3_pros",
      "idx": 11,
      "start": 315.983,
      "end": 320.07,
      "text": "元世界王者の亀田大毅さんはひゃくじゅうよんたいひゃくじゅうさん。"
    },
    {
      "id": "3_pros12",
      "sec": "s3_pros",
      "idx": 12,
      "start": 320.35,
      "end": 328.291,
      "text": "元にかいきゅうせいは王者の京口紘人選手はひゃくじゅうろくたいひゃくじゅういちで、公式の採点とぴったり同じでした。"
    },
    {
      "id": "3_pros13",
      "sec": "s3_pros",
      "idx": 13,
      "start": 328.571,
      "end": 338.045,
      "text": "元世界王者の渡嘉敷勝男さん、竹原慎二さん、畑山隆則さん。さんにんはそろってさんポイント差で井上拓真選手でした。"
    },
    {
      "id": "3_pros14",
      "sec": "s3_pros",
      "idx": 14,
      "start": 338.325,
      "end": 342.737,
      "text": "逆に、元プロボクサーの細川バレンタインさんは納得していません。"
    },
    {
      "id": "3_pros15",
      "sec": "s3_pros",
      "idx": 15,
      "start": 343.017,
      "end": 347.661,
      "text": "ダウンがあったのにごポイント差は意味がわからない。そう話しました。"
    },
    {
      "id": "3_pros16",
      "sec": "s3_pros",
      "idx": 16,
      "start": 347.941,
      "end": 353.281,
      "text": "RIZINの堀口恭司選手も、ちょっとかわいそうだなと思ったと感想を残しています。"
    },
    {
      "id": "3_pros17",
      "sec": "s3_pros",
      "idx": 17,
      "start": 353.561,
      "end": 360.992,
      "text": "那須川天心選手のにポイント勝ちから、井上拓真選手のごポイント勝ちまで。プロの目でこれだけ開きました。"
    },
    {
      "id": "4_fullmark00",
      "sec": "s4_fullmark",
      "idx": 0,
      "start": 363.722,
      "end": 368.923,
      "text": "これだけ採点が割れた一方で、ほとんどの人が同じ一点を疑問に挙げています。"
    },
    {
      "id": "4_fullmark01",
      "sec": "s4_fullmark",
      "idx": 1,
      "start": 369.203,
      "end": 372.825,
      "text": "よんラウンド時点のよんじゅうたいさんじゅうろく。フルマークです。"
    },
    {
      "id": "4_fullmark02",
      "sec": "s4_fullmark",
      "idx": 2,
      "start": 373.105,
      "end": 378.075,
      "text": "具志堅用高さんは、よんラウンドまでの採点でフルマークはおかしいと言いました。"
    },
    {
      "id": "4_fullmark03",
      "sec": "s4_fullmark",
      "idx": 3,
      "start": 378.355,
      "end": 383.324,
      "text": "内藤大助さんも、自分の採点ではフルマークにはならないと話しています。"
    },
    {
      "id": "4_fullmark04",
      "sec": "s4_fullmark",
      "idx": 4,
      "start": 383.604,
      "end": 389.362,
      "text": "久保隼さんは、よんじゅうたいさんじゅうろくは那須川天心選手に厳しすぎると指摘しました。"
    },
    {
      "id": "4_fullmark05",
      "sec": "s4_fullmark",
      "idx": 5,
      "start": 389.642,
      "end": 395.958,
      "text": "さんじゅうきゅうたいさんじゅうななで那須川天心選手という人がいても不思議ではないという言い方です。"
    },
    {
      "id": "4_fullmark06",
      "sec": "s4_fullmark",
      "idx": 6,
      "start": 396.238,
      "end": 401.579,
      "text": "魔裟斗さんも、最初の公開採点でフルマークが出ていたことに驚いています。"
    },
    {
      "id": "4_fullmark07",
      "sec": "s4_fullmark",
      "idx": 7,
      "start": 401.859,
      "end": 407.71,
      "text": "渡嘉敷勝男さんたちの番組でも、フルマークがひとりいたという一点に話が集まりました。"
    },
    {
      "id": "4_fullmark08",
      "sec": "s4_fullmark",
      "idx": 8,
      "start": 407.99,
      "end": 413.841,
      "text": "よんじゅうたいさんじゅうろくをつける人がいれば、さんじゅうはちたいさんじゅうはちをつける人もいる。"
    },
    {
      "id": "4_fullmark09",
      "sec": "s4_fullmark",
      "idx": 9,
      "start": 414.121,
      "end": 419.044,
      "text": "賛否が真っ二つに割れたこの試合で、ここだけは評価が一致しました。"
    },
    {
      "id": "5_cards00",
      "sec": "s5_cards",
      "idx": 0,
      "start": 421.774,
      "end": 426.325,
      "text": "では、さんにんのジャッジは実際にどのラウンドを誰につけたのでしょうか。"
    },
    {
      "id": "5_cards01",
      "sec": "s5_cards",
      "idx": 1,
      "start": 426.605,
      "end": 429.02,
      "text": "公開されている情報はよっつあります。"
    },
    {
      "id": "5_cards02",
      "sec": "s5_cards",
      "idx": 2,
      "start": 429.3,
      "end": 434.501,
      "text": "よんラウンド時点の採点。はちラウンド時点の採点。そして最終スコア。"
    },
    {
      "id": "5_cards03",
      "sec": "s5_cards",
      "idx": 3,
      "start": 434.781,
      "end": 441.004,
      "text": "さらに公式の採点表には、各ラウンドを何人が誰につけたかという内訳が残っています。"
    },
    {
      "id": "5_cards04",
      "sec": "s5_cards",
      "idx": 4,
      "start": 441.284,
      "end": 447.368,
      "text": "このよっつを突き合わせると、さんにんのカードはいちラウンドずつひとつの形にしか決まりません。"
    },
    {
      "id": "5_cards05",
      "sec": "s5_cards",
      "idx": 5,
      "start": 447.648,
      "end": 451.456,
      "text": "まず、さんにん全員が井上拓真選手につけたラウンドです。"
    },
    {
      "id": "5_cards06",
      "sec": "s5_cards",
      "idx": 6,
      "start": 451.736,
      "end": 458.238,
      "text": "いちラウンド。さんラウンド。ごラウンド。はちラウンド。きゅうラウンド。じゅういちラウンド。"
    },
    {
      "id": "5_cards07",
      "sec": "s5_cards",
      "idx": 7,
      "start": 458.518,
      "end": 460.004,
      "text": "あわせてろくつありました。"
    },
    {
      "id": "5_cards08",
      "sec": "s5_cards",
      "idx": 8,
      "start": 460.284,
      "end": 465.299,
      "text": "では、さんにん全員が那須川天心選手につけたラウンドはいくつあったでしょうか。"
    },
    {
      "id": "5_cards09",
      "sec": "s5_cards",
      "idx": 9,
      "start": 465.579,
      "end": 468.969,
      "text": "ひとつです。ダウンを奪ったななラウンドだけでした。"
    },
    {
      "id": "5_cards10",
      "sec": "s5_cards",
      "idx": 10,
      "start": 469.249,
      "end": 476.029,
      "text": "採点が割れたのはごつです。にラウンド。よんラウンド。ろくラウンド。じゅうラウンド。じゅうにラウンド。"
    },
    {
      "id": "5_cards11",
      "sec": "s5_cards",
      "idx": 11,
      "start": 476.309,
      "end": 480.907,
      "text": "ここに、中継で表示されていたパンチ統計のCompuBoxを重ねます。"
    },
    {
      "id": "5_cards12",
      "sec": "s5_cards",
      "idx": 12,
      "start": 481.187,
      "end": 487.038,
      "text": "いちラウンドのヒット数は、井上拓真選手がにはつ、那須川天心選手もにはつ。"
    },
    {
      "id": "5_cards13",
      "sec": "s5_cards",
      "idx": 13,
      "start": 487.318,
      "end": 493.541,
      "text": "まったく同じです。それでもさんにん全員が、このラウンドを井上拓真選手につけました。"
    },
    {
      "id": "5_cards14",
      "sec": "s5_cards",
      "idx": 14,
      "start": 493.821,
      "end": 498.512,
      "text": "にラウンドは井上拓真選手がななはつ、那須川天心選手がはちはつ。"
    },
    {
      "id": "5_cards15",
      "sec": "s5_cards",
      "idx": 15,
      "start": 498.792,
      "end": 506.362,
      "text": "那須川天心選手がいっぱつ多いラウンドで、ふたりが那須川天心選手、ひとりが井上拓真選手に割れました。"
    },
    {
      "id": "5_cards16",
      "sec": "s5_cards",
      "idx": 16,
      "start": 506.642,
      "end": 511.796,
      "text": "ろくラウンドは井上拓真選手がじゅっぱつ、那須川天心選手がじゅうにはつ。"
    },
    {
      "id": "5_cards17",
      "sec": "s5_cards",
      "idx": 17,
      "start": 512.076,
      "end": 517.278,
      "text": "じゅうラウンドも井上拓真選手がじゅっぱつ、那須川天心選手がじゅうにはつ。"
    },
    {
      "id": "5_cards18",
      "sec": "s5_cards",
      "idx": 18,
      "start": 517.558,
      "end": 521.133,
      "text": "じゅうにラウンドは、はちはつたいはちはつで同数でした。"
    },
    {
      "id": "5_cards19",
      "sec": "s5_cards",
      "idx": 19,
      "start": 521.413,
      "end": 524.664,
      "text": "この三つのラウンドも、すべて採点が割れています。"
    },
    {
      "id": "5_cards20",
      "sec": "s5_cards",
      "idx": 20,
      "start": 524.944,
      "end": 531.817,
      "text": "つまり採点が割れたごつのラウンドは、すべて数字が互角か那須川天心選手が上回ったラウンドでした。"
    },
    {
      "id": "5_cards21",
      "sec": "s5_cards",
      "idx": 21,
      "start": 532.097,
      "end": 536.138,
      "text": "逆に、数字で差がついたラウンドではさんにんが揃っています。"
    },
    {
      "id": "5_cards22",
      "sec": "s5_cards",
      "idx": 22,
      "start": 536.418,
      "end": 541.48,
      "text": "ごラウンドはじゅうごはつたいごはつ。じゅういちラウンドはじゅうきゅうはつたいじゅっぱつ。"
    },
    {
      "id": "5_cards23",
      "sec": "s5_cards",
      "idx": 23,
      "start": 541.76,
      "end": 544.546,
      "text": "どちらも全員が井上拓真選手です。"
    },
    {
      "id": "5_cards24",
      "sec": "s5_cards",
      "idx": 24,
      "start": 544.826,
      "end": 551.095,
      "text": "ななラウンドはごはつたいじゅうはちはつ。ダウンもあり、全員がじゅうたいはちをつけました。"
    },
    {
      "id": "5_cards25",
      "sec": "s5_cards",
      "idx": 25,
      "start": 551.375,
      "end": 555.509,
      "text": "割れたのは、どちらが当てたのかがはっきりしないラウンドだけでした。"
    },
    {
      "id": "5_cards26",
      "sec": "s5_cards",
      "idx": 26,
      "start": 555.789,
      "end": 560.34,
      "text": "言いかえれば、この試合の採点を割ったのは有効打の数ではありません。"
    },
    {
      "id": "5_cards27",
      "sec": "s5_cards",
      "idx": 27,
      "start": 560.62,
      "end": 565.124,
      "text": "数字では決まらないラウンドを、さんにんが別々に判断した結果です。"
    },
    {
      "id": "6_criteria00",
      "sec": "s6_criteria",
      "idx": 0,
      "start": 567.854,
      "end": 572.266,
      "text": "ボクシングの採点は、じゅうポイントマストという方式で行われます。"
    },
    {
      "id": "6_criteria01",
      "sec": "s6_criteria",
      "idx": 1,
      "start": 572.546,
      "end": 577.562,
      "text": "ラウンドを取ったほうにじゅうポイント。取られたほうにきゅうポイント以下をつけます。"
    },
    {
      "id": "6_criteria02",
      "sec": "s6_criteria",
      "idx": 2,
      "start": 577.842,
      "end": 582.764,
      "text": "ダウンがあればはちポイントです。ななラウンドのじゅうたいはちがこれにあたります。"
    },
    {
      "id": "6_criteria03",
      "sec": "s6_criteria",
      "idx": 3,
      "start": 583.044,
      "end": 587.642,
      "text": "では、どちらがラウンドを取ったのかをジャッジは何で判断するのでしょうか。"
    },
    {
      "id": "6_criteria04",
      "sec": "s6_criteria",
      "idx": 4,
      "start": 587.922,
      "end": 590.662,
      "text": "JBCが示している基準はよっつです。"
    },
    {
      "id": "6_criteria05",
      "sec": "s6_criteria",
      "idx": 5,
      "start": 590.942,
      "end": 595.539,
      "text": "有効打。攻撃性。リングジェネラルシップ。そしてディフェンスです。"
    },
    {
      "id": "6_criteria06",
      "sec": "s6_criteria",
      "idx": 6,
      "start": 595.819,
      "end": 599.256,
      "text": "このよっつを総合して、各ラウンドを判断します。"
    },
    {
      "id": "6_criteria07",
      "sec": "s6_criteria",
      "idx": 7,
      "start": 599.536,
      "end": 602.09,
      "text": "手数の多さはこの中に入っていません。"
    },
    {
      "id": "6_criteria08",
      "sec": "s6_criteria",
      "idx": 8,
      "start": 602.37,
      "end": 607.571,
      "text": "この試合で多く打ったのは那須川天心選手でした。よんひゃくきゅうじゅうはっぱつです。"
    },
    {
      "id": "6_criteria09",
      "sec": "s6_criteria",
      "idx": 9,
      "start": 607.851,
      "end": 614.353,
      "text": "井上拓真選手はよんひゃくにじゅっぱつ。那須川天心選手のほうがななじゅうはっぱつ多く打っています。"
    },
    {
      "id": "6_criteria10",
      "sec": "s6_criteria",
      "idx": 10,
      "start": 614.633,
      "end": 616.862,
      "text": "ところが当てた数は逆でした。"
    },
    {
      "id": "6_criteria11",
      "sec": "s6_criteria",
      "idx": 11,
      "start": 617.142,
      "end": 623.086,
      "text": "井上拓真選手がひゃくにじゅういっぱつ。那須川天心選手がきゅうじゅうきゅうはつです。"
    },
    {
      "id": "6_criteria12",
      "sec": "s6_criteria",
      "idx": 12,
      "start": 623.366,
      "end": 627.732,
      "text": "的中率はにじゅうはちてんはちパーセントと、じゅうきゅうてんきゅうパーセント。"
    },
    {
      "id": "6_criteria13",
      "sec": "s6_criteria",
      "idx": 13,
      "start": 628.012,
      "end": 635.349,
      "text": "強いパンチだけを見ても、井上拓真選手がひゃくいっぱつ、那須川天心選手がはちじゅうななはつでした。"
    },
    {
      "id": "6_criteria14",
      "sec": "s6_criteria",
      "idx": 14,
      "start": 635.629,
      "end": 641.62,
      "text": "ただし、那須川天心選手が明確に上回った部分もあります。ボディへのヒットです。"
    },
    {
      "id": "6_criteria15",
      "sec": "s6_criteria",
      "idx": 15,
      "start": 641.9,
      "end": 647.426,
      "text": "井上拓真選手がにじゅうごはつ。那須川天心選手はさんじゅうろっぱつ当てています。"
    },
    {
      "id": "6_criteria16",
      "sec": "s6_criteria",
      "idx": 16,
      "start": 647.706,
      "end": 654.904,
      "text": "打った数は那須川天心選手。当てた数は井上拓真選手。ボディは那須川天心選手。"
    },
    {
      "id": "6_criteria17",
      "sec": "s6_criteria",
      "idx": 17,
      "start": 655.184,
      "end": 660.525,
      "text": "三つの数字が別々の方向を向いているから、見る人によって印象が変わります。"
    },
    {
      "id": "6_criteria18",
      "sec": "s6_criteria",
      "idx": 18,
      "start": 660.805,
      "end": 663.034,
      "text": "浜田剛史代表はこう言っています。"
    },
    {
      "id": "6_criteria19",
      "sec": "s6_criteria",
      "idx": 19,
      "start": 663.314,
      "end": 670.28,
      "text": "採点基準はやくさんじゅうねんになりますけど、ボクシング関係者の間でも真っ二つに分かれることがある。"
    },
    {
      "id": "7_last400",
      "sec": "s7_last4",
      "idx": 0,
      "start": 673.01,
      "end": 677.236,
      "text": "ここでもう一度、はちラウンド終了時点の公開採点に戻ります。"
    },
    {
      "id": "7_last401",
      "sec": "s7_last4",
      "idx": 1,
      "start": 677.516,
      "end": 681.417,
      "text": "ふたりのジャッジはななじゅうななたいななじゅうよんで井上拓真選手。"
    },
    {
      "id": "7_last402",
      "sec": "s7_last4",
      "idx": 2,
      "start": 681.697,
      "end": 687.502,
      "text": "ですがもうひとりは、ななじゅうろくたいななじゅうごで那須川天心選手をリードさせていました。"
    },
    {
      "id": "7_last403",
      "sec": "s7_last4",
      "idx": 3,
      "start": 687.782,
      "end": 694.423,
      "text": "このジャッジは、にラウンドとよんラウンド、ろくラウンドとななラウンドを那須川天心選手につけています。"
    },
    {
      "id": "7_last404",
      "sec": "s7_last4",
      "idx": 4,
      "start": 694.703,
      "end": 701.158,
      "text": "残りはよんラウンド。那須川天心選手はこのうちふたつを取れば、このカードで勝っていました。"
    },
    {
      "id": "7_last405",
      "sec": "s7_last4",
      "idx": 5,
      "start": 701.438,
      "end": 702.878,
      "text": "ひとつでも引き分けです。"
    },
    {
      "id": "7_last406",
      "sec": "s7_last4",
      "idx": 6,
      "start": 703.158,
      "end": 709.985,
      "text": "しかしこのジャッジは、きゅうラウンドとじゅうラウンド、じゅういちラウンドを連続で井上拓真選手につけました。"
    },
    {
      "id": "7_last407",
      "sec": "s7_last4",
      "idx": 7,
      "start": 710.265,
      "end": 715.605,
      "text": "最後のじゅうにラウンドを那須川天心選手に戻しても、ひゃくじゅうよんたいひゃくじゅうさん。"
    },
    {
      "id": "7_last408",
      "sec": "s7_last4",
      "idx": 8,
      "start": 715.885,
      "end": 717.882,
      "text": "いちポイント届きませんでした。"
    },
    {
      "id": "7_last409",
      "sec": "s7_last4",
      "idx": 9,
      "start": 718.162,
      "end": 724.06,
      "text": "ダウンを奪った直後ではなく、終盤のさんラウンドでこのカードは逆転していたことになります。"
    },
    {
      "id": "7_last410",
      "sec": "s7_last4",
      "idx": 10,
      "start": 724.34,
      "end": 730.981,
      "text": "中でもじゅういちラウンドは、井上拓真選手がじゅうきゅうはつ、那須川天心選手がじゅっぱつ。"
    },
    {
      "id": "7_last411",
      "sec": "s7_last4",
      "idx": 11,
      "start": 731.261,
      "end": 735.812,
      "text": "ほぼにばいの差がつき、さんにん全員が井上拓真選手につけています。"
    },
    {
      "id": "7_last412",
      "sec": "s7_last4",
      "idx": 12,
      "start": 736.092,
      "end": 740.736,
      "text": "後半は落ちると言われていた王者が、いちばん差をつけたのが終盤でした。"
    },
    {
      "id": "8_down00",
      "sec": "s8_down",
      "idx": 0,
      "start": 743.466,
      "end": 747.738,
      "text": "そのななラウンド。ダウンの瞬間に何が起きていたのでしょうか。"
    },
    {
      "id": "8_down01",
      "sec": "s8_down",
      "idx": 1,
      "start": 748.018,
      "end": 752.059,
      "text": "内山高志さんは、その直前の攻防を見ていました。"
    },
    {
      "id": "8_down02",
      "sec": "s8_down",
      "idx": 2,
      "start": 752.339,
      "end": 759.072,
      "text": "すれすれの攻防が終わった直後です。井上拓真選手が笑った。笑った瞬間でしたよね。"
    },
    {
      "id": "8_down03",
      "sec": "s8_down",
      "idx": 3,
      "start": 759.352,
      "end": 763.578,
      "text": "一瞬の油断を、那須川天心選手の左が捉えていました。"
    },
    {
      "id": "8_down04",
      "sec": "s8_down",
      "idx": 4,
      "start": 763.858,
      "end": 767.574,
      "text": "ダウンのあと、那須川天心選手は追撃に出ます。"
    },
    {
      "id": "8_down05",
      "sec": "s8_down",
      "idx": 5,
      "start": 767.854,
      "end": 771.615,
      "text": "ですが井上拓真選手は、そのラウンドを乗り切りました。"
    },
    {
      "id": "8_down06",
      "sec": "s8_down",
      "idx": 6,
      "start": 771.895,
      "end": 775.425,
      "text": "具志堅用高さんは、ここに別の見方をしています。"
    },
    {
      "id": "8_down07",
      "sec": "s8_down",
      "idx": 7,
      "start": 775.705,
      "end": 780.163,
      "text": "あそこで休むからダメ。キックとボクシングの差が出た。"
    },
    {
      "id": "8_down08",
      "sec": "s8_down",
      "idx": 8,
      "start": 780.443,
      "end": 785.737,
      "text": "追撃を仕掛けた那須川天心選手が、途中で足を止めてしまったという指摘です。"
    },
    {
      "id": "8_down09",
      "sec": "s8_down",
      "idx": 9,
      "start": 786.017,
      "end": 793.308,
      "text": "そしてインターバル。井上拓真選手の父でありトレーナーでもある井上真吾さんが、厳しく言葉をかけます。"
    },
    {
      "id": "8_down10",
      "sec": "s8_down",
      "idx": 10,
      "start": 793.588,
      "end": 803.155,
      "text": "次のはちラウンド。井上拓真選手のヒット数が那須川天心選手を上回り、さんにん全員がこのラウンドを井上拓真選手につけました。"
    },
    {
      "id": "8_down11",
      "sec": "s8_down",
      "idx": 11,
      "start": 803.435,
      "end": 805.757,
      "text": "内山高志さんはこう評価しています。"
    },
    {
      "id": "8_down12",
      "sec": "s8_down",
      "idx": 12,
      "start": 806.037,
      "end": 812.817,
      "text": "はちラウンドで井上拓真選手は自分から出てきて、相手を引き寄せた。そこが今のチャンピオンだ。"
    },
    {
      "id": "8_down13",
      "sec": "s8_down",
      "idx": 13,
      "start": 813.097,
      "end": 818.391,
      "text": "ダウンを奪われたあとのさんぷんが、この試合でいちばん大きかったのかもしれません。"
    },
    {
      "id": "9_end00",
      "sec": "s9_end",
      "idx": 0,
      "start": 821.121,
      "end": 827.298,
      "text": "公式の採点は、さんにん全員が井上拓真選手でした。この結果は覆りません。"
    },
    {
      "id": "9_end01",
      "sec": "s9_end",
      "idx": 1,
      "start": 827.578,
      "end": 831.804,
      "text": "ですが、さんにんのカードが割れたのは偶然ではありませんでした。"
    },
    {
      "id": "9_end02",
      "sec": "s9_end",
      "idx": 2,
      "start": 832.084,
      "end": 836.635,
      "text": "割れたのは、どちらが当てたのかが数字で決まらないごつのラウンドです。"
    },
    {
      "id": "9_end03",
      "sec": "s9_end",
      "idx": 3,
      "start": 836.915,
      "end": 841.512,
      "text": "そのごつでは、むしろ那須川天心選手のほうが多く取っています。"
    },
    {
      "id": "9_end04",
      "sec": "s9_end",
      "idx": 4,
      "start": 841.792,
      "end": 847.319,
      "text": "勝敗を決めたのは、さんにんが揃って井上拓真選手につけたろくつのラウンドでした。"
    },
    {
      "id": "9_end05",
      "sec": "s9_end",
      "idx": 5,
      "start": 847.599,
      "end": 850.896,
      "text": "那須川天心選手は試合後こう話しました。"
    },
    {
      "id": "9_end06",
      "sec": "s9_end",
      "idx": 6,
      "start": 851.176,
      "end": 857.306,
      "text": "難しすぎます。倒すだけがボクシングじゃないんだなと。経験、実力不足です。"
    },
    {
      "id": "9_end07",
      "sec": "s9_end",
      "idx": 7,
      "start": 857.586,
      "end": 863.67,
      "text": "倒すだけがボクシングじゃない。その言葉が、ふたつの数字の差をそのまま言い表しています。"
    },
    {
      "id": "9_end08",
      "sec": "s9_end",
      "idx": 8,
      "start": 863.95,
      "end": 867.293,
      "text": "打った数ではなく当てた数。そしてどう見えたか。"
    },
    {
      "id": "9_end09",
      "sec": "s9_end",
      "idx": 9,
      "start": 867.573,
      "end": 871.474,
      "text": "世界戦のじゅうにラウンドは、その積み重ねで決まりました。"
    },
    {
      "id": "9_end10",
      "sec": "s9_end",
      "idx": 10,
      "start": 871.754,
      "end": 876.305,
      "text": "那須川天心選手の次の一戦は、まだ発表されていません。"
    },
    {
      "id": "9_end11",
      "sec": "s9_end",
      "idx": 11,
      "start": 876.585,
      "end": 882.065,
      "text": "ご視聴ありがとうございました。チャンネル登録と高評価をいただけると励みになります。"
    }
  ],
