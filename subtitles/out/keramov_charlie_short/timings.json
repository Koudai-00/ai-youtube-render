{
  "episode": "keramov_charlie_short",
  "total": 71.321,
  "beats": [
    {
      "id": "t0",
      "idx": 0,
      "start": 0.18,
      "end": 5.697,
      "text": "たいじゅうちょうかを防いでスーパーライジンファイブを救った、チャーリーかしわぎのおとこぎがヤバすぎる。"
    },
    {
      "id": "h1",
      "idx": 1,
      "start": 5.857,
      "end": 9.582,
      "text": "ライジンのマッチメイカーが、選手と一緒にサウナに入っていました。"
    },
    {
      "id": "h2",
      "idx": 2,
      "start": 9.742,
      "end": 13.791,
      "text": "スーパーライジンファイブの前日、ケラモフ選手の減量が止まったんです。"
    },
    {
      "id": "c1",
      "idx": 3,
      "start": 13.951,
      "end": 18.484,
      "text": "夜の時点でいってんななキロオーバー。朝までにごひゃくグラム落ちる予定でした。"
    },
    {
      "id": "c2",
      "idx": 4,
      "start": 18.644,
      "end": 21.306,
      "text": "ところが朝、落ちていたのはにひゃくグラムだけ。"
    },
    {
      "id": "c3",
      "idx": 5,
      "start": 21.466,
      "end": 22.829,
      "text": "ここで心が折れます。"
    },
    {
      "id": "c4",
      "idx": 6,
      "start": 22.989,
      "end": 26.673,
      "text": "セコンドも諦めて、キャッチウェイトでどうかと相談してきたそうです。"
    },
    {
      "id": "c5",
      "idx": 7,
      "start": 26.833,
      "end": 30.265,
      "text": "これに激怒したのが、マッチメイカーのチャーリーかしわぎさんです。"
    },
    {
      "id": "c6",
      "idx": 8,
      "start": 30.425,
      "end": 33.99,
      "text": "こんな大きな大会でキャッチウェイトなんてできるわけがないだろうと。"
    },
    {
      "id": "c7",
      "idx": 9,
      "start": 34.15,
      "end": 37.956,
      "text": "そして自分でケラモフ選手を連れて、一緒にサウナへ入ります。"
    },
    {
      "id": "c9",
      "idx": 10,
      "start": 38.116,
      "end": 44.972,
      "text": "この大会にライジンがどれだけかけているか。お前の立場を喉から手が出るほど欲しい選手が、なんびゃくにんもいるんだぞ。"
    },
    {
      "id": "c10",
      "idx": 11,
      "start": 45.132,
      "end": 49.586,
      "text": "その中でお前が選ばれてる。順番待ちしてる選手に失礼だろうと。"
    },
    {
      "id": "c11",
      "idx": 12,
      "start": 49.746,
      "end": 54.604,
      "text": "ロシア語なので通訳をはさみましたが、その通訳が倍の勢いで伝えたそうです。"
    },
    {
      "id": "c12",
      "idx": 13,
      "start": 54.764,
      "end": 58.244,
      "text": "するとコーチから、ケラモフの目にやる気が宿った、と。"
    },
    {
      "id": "e1",
      "idx": 14,
      "start": 58.404,
      "end": 60.371,
      "text": "結果はろくじゅうろくキロでクリア。"
    },
    {
      "id": "e2",
      "idx": 15,
      "start": 60.531,
      "end": 64.21,
      "text": "全部かしわぎさんのおかげだ。セコンドはそう感謝したそうです。"
    },
    {
      "id": "e3",
      "idx": 16,
      "start": 64.37,
      "end": 68.333,
      "text": "かしわぎさんの返事は、そんなこと言うなよ、やったのはお前だよ。"
    },
    {
      "id": "e4",
      "idx": 17,
      "start": 68.493,
      "end": 70.871,
      "text": "あなたはこの裏側、どう見ますか?"
    }
  ]
}